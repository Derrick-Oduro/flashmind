@page "/login"
@inject NavigationManager Navigation

<PageTitle>Sign in - FlashMind</PageTitle>

<div class="container my-5" style="max-width: 460px;">
    <div class="card">
        <div class="card-body p-4">
            <h1 class="h3 mb-3">Sign in</h1>

            @if (Navigation.Uri.Contains("error=invalid", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-danger">The email address or password is incorrect.</div>
            }

            <form method="post" action="/account/login">
                <AntiforgeryToken />
                <input name="ReturnUrl" type="hidden" value="@ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label" for="email">Email address</label>
                    <input id="email" class="form-control" name="Email" type="email" autocomplete="email" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input id="password" class="form-control" name="Password" type="password" autocomplete="current-password" required />
                </div>
                <div class="form-check mb-3">
                    <input id="remember-me" class="form-check-input" name="RememberMe" type="checkbox" />
                    <label class="form-check-label" for="remember-me">Keep me signed in</label>
                </div>
                <button class="btn btn-primary w-100" type="submit">Sign in</button>
            </form>

            <p class="text-center mt-3 mb-0">New to FlashMind? <a href="/register">Create an account</a></p>
        </div>
    </div>
</div>

@code {
    private string ReturnUrl
    {
        get
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
            return query.TryGetValue("ReturnUrl", out var returnUrl) ? returnUrl.ToString() : "/";
        }
    }
}
