@page "/study/{DeckId:int}"
@attribute [Authorize]
@using Flashminds.Data
@using Flashminds.Models
@using Flashminds.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<FlashmindsContext> ContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SpacedRepetitionService RepetitionService
@inject NavigationManager Navigation

<PageTitle>Study - FlashMind</PageTitle>

<div class="app-page">
    @if (deck == null)
    {
        <p>Loading...</p>
    }
    else if (cardsToStudy.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">✓</div>
            <h2>All caught up</h2>
            <p>No cards are due for review right now. Great work.</p>
            <a href="/decks" class="btn btn-primary">Back to Decks</a>
        </div>
    }
    else if (currentCardIndex < cardsToStudy.Count)
    {
        var currentCard = cardsToStudy[currentCardIndex];
        var progress = ((currentCardIndex + 1) * 100) / cardsToStudy.Count;

        <div class="study-shell mx-auto">
                <div class="study-heading">
                    <div><div class="eyebrow">Study session</div><h1>@deck.Title</h1></div>
                    <span class="study-count">@(currentCardIndex + 1) of @cardsToStudy.Count</span>
                </div>

                <div class="progress study-progress">
                    <div class="progress-bar bg-info" role="progressbar" 
                         style="width: @(progress)%"
                         aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>

                <div class="card-study mb-4">
                    <div class="card-container" @onclick="ToggleCard" tabindex="0" role="button" @onkeydown="HandleCardKeydown" aria-label="Reveal or hide answer">
                        @if (!isFlipped)
                        {
                        <div class="card-face front">
                            <div class="card-label">@(IsCloze(currentCard) ? "Fill in the blank" : "Question")</div>
                            <div class="card-content">@(IsCloze(currentCard) ? ClozePrompt(currentCard.Question) : currentCard.Question)</div>
                            @if (!string.IsNullOrWhiteSpace(currentCard.Hint))
                            {
                                <div class="card-hint">Hint: @currentCard.Hint</div>
                            }
                            @if (IsCloze(currentCard))
                            {
                                <input class="cloze-answer-input" @bind="typedAnswer" @onclick:stopPropagation="true" placeholder="Type your answer" aria-label="Your answer" />
                                <button class="btn btn-secondary btn-sm mt-3" @onclick="RevealAnswer" @onclick:stopPropagation="true">Check answer</button>
                            }
                            else
                            {
                                <div class="card-hint">Click to reveal answer</div>
                            }
                        </div>
                        }
                        else
                        {
                        <div class="card-face back">
                            <div class="card-label">Answer</div>
                            <div class="card-content">@(IsCloze(currentCard) ? ClozeAnswer(currentCard) : currentCard.Answer)</div>
                            @if (IsCloze(currentCard) && !string.IsNullOrWhiteSpace(typedAnswer))
                            {
                                <div class="card-hint">Your answer: @typedAnswer</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(currentCard.Explanation))
                            {
                                <div class="card-explanation">@currentCard.Explanation</div>
                            }
                            <div class="card-hint">Click to hide answer</div>
                        </div>
                        }
                    </div>
                </div>

                @if (isFlipped)
                {
                    <div class="response-grid">
                                <button class="response-btn response-again" @onclick="() => MarkCard(1)">
                                    ❌ Again
                                    <small>1 day</small>
                                </button>
                                <button class="response-btn response-hard" @onclick="() => MarkCard(2)">
                                    ⚠️ Hard
                                    <small>3 days</small>
                                </button>
                                <button class="response-btn response-good" @onclick="() => MarkCard(3)">
                                    👍 Good
                                    <small>7 days</small>
                                </button>
                                <button class="response-btn response-easy" @onclick="() => MarkCard(4)">
                                    ⭐ Easy
                                    <small>14 days</small>
                                </button>
                    </div>
                }
                else
                {
                    <p class="study-tip">Click the card to reveal the answer.</p>
                }

                <div class="study-back">
                    <a href="/decks" class="btn btn-secondary btn-sm">← Back to Decks</a>
                </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">✦</div>
            <h2>Study session complete</h2>
            <p>You reviewed @sessionStats.ReviewCount cards. Great work!</p>
            <div class="mb-3">
                <strong>Accuracy: @Math.Round(sessionStats.Accuracy)%</strong>
            </div>
            <a href="/decks" class="btn btn-primary">Back to Decks</a>
        </div>
    }
</div>

@code {
    [Parameter]
    public int DeckId { get; set; }

    private Deck? deck;
    private List<Card> cardsToStudy = new();
    private int currentCardIndex = 0;
    private bool isFlipped = false;
    private string typedAnswer = "";
    private SessionStats sessionStats = new();
    private StudySession? studySession;
    private string? userId;

    private void ToggleCard()
    {
        isFlipped = !isFlipped;
    }

    private void HandleCardKeydown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            ToggleCard();
        }
    }

    private void RevealAnswer() => isFlipped = true;

    private static bool IsCloze(Card card) => string.Equals(card.CardType, "Cloze", StringComparison.OrdinalIgnoreCase);

    private static string ClozePrompt(string source) => System.Text.RegularExpressions.Regex.Replace(
        source,
        @"\{\{c\d+::.*?(?:::[^}]*)?\}\}",
        "____",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private static string ClozeAnswer(Card card)
    {
        var match = System.Text.RegularExpressions.Regex.Match(card.Question, @"\{\{c\d+::(.*?)(?:::[^}]*)?\}\}", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return match.Success ? match.Groups[1].Value.Trim() : card.Answer;
    }

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadStudyCardsAsync();
    }

    private async Task LoadStudyCardsAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        deck = await context.Decks
            .AsNoTracking()
            .Include(d => d.Cards)
            .FirstOrDefaultAsync(d => d.Id == DeckId && d.OwnerId == userId);

        if (deck != null)
        {
            cardsToStudy = RepetitionService.GetCardsDueToday(deck.Cards);
        }
    }

    private async Task MarkCard(int difficulty)
    {
        if (currentCardIndex >= cardsToStudy.Count)
            return;

        var currentCard = cardsToStudy[currentCardIndex];
        await using var context = await ContextFactory.CreateDbContextAsync();
        var storedCard = await context.Cards
            .Include(c => c.Deck)
            .FirstOrDefaultAsync(c => c.Id == currentCard.Id && c.Deck!.OwnerId == userId);
        if (storedCard is null)
        {
            await LoadStudyCardsAsync();
            return;
        }

        // Update card with spaced repetition logic
        RepetitionService.UpdateCardInterval(storedCard, difficulty);

        // Create the session only when the user answers their first card.
        // This avoids recording empty sessions when a user opens and leaves a deck.
        var isNewSession = studySession is null;
        studySession ??= new StudySession
        {
            DeckId = DeckId,
            StartedAt = DateTime.UtcNow
        };

        sessionStats.ReviewCount++;
        studySession.CardReviewedCount++;
        if (difficulty >= 3)
        {
            sessionStats.CorrectCount++;
            studySession.CardCorrectCount++;
        }

        studySession.DurationSeconds = (int)(DateTime.UtcNow - studySession.StartedAt).TotalSeconds;
        if (currentCardIndex + 1 == cardsToStudy.Count)
        {
            studySession.CompletedAt = DateTime.UtcNow;
        }

        if (isNewSession)
        {
            context.StudySessions.Add(studySession);
        }
        else
        {
            context.StudySessions.Update(studySession);
        }

        context.CardReviews.Add(new CardReview
        {
            CardId = storedCard.Id,
            StudySession = studySession,
            Difficulty = difficulty
        });

        await context.SaveChangesAsync();

        // Move to next card
        isFlipped = false;
        typedAnswer = "";
        currentCardIndex++;
    }

    private class SessionStats
    {
        public int ReviewCount { get; set; }
        public int CorrectCount { get; set; }

        public double Accuracy => ReviewCount > 0 
            ? Math.Round((double)CorrectCount / ReviewCount * 100, 1) 
            : 0;
    }
}
