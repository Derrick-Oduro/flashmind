@page "/study/{DeckId:int}"
@using Flashminds.Data
@using Flashminds.Models
@using Flashminds.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<FlashmindsContext> ContextFactory
@inject SpacedRepetitionService RepetitionService
@inject NavigationManager Navigation

<PageTitle>Study - FlashMind</PageTitle>

<div class="container my-5">
    @if (deck == null)
    {
        <p>Loading...</p>
    }
    else if (cardsToStudy.Count == 0)
    {
        <div class="alert alert-info text-center">
            <h4>✅ All caught up!</h4>
            <p>No cards due for review right now. Great job!</p>
            <a href="/decks" class="btn btn-primary">Back to Decks</a>
        </div>
    }
    else if (currentCardIndex < cardsToStudy.Count)
    {
        var currentCard = cardsToStudy[currentCardIndex];
        var progress = ((currentCardIndex + 1) * 100) / cardsToStudy.Count;

        <div class="row justify-content-center">
            <div class="col-md-8">
                <h2 class="mb-4">📖 Studying: @deck.Title</h2>

                <!-- Progress Bar -->
                <div class="progress mb-4" style="height: 25px;">
                    <div class="progress-bar bg-info" role="progressbar" 
                         style="width: @(progress)%"
                         aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                        @(currentCardIndex + 1) / @cardsToStudy.Count
                    </div>
                </div>

                <!-- Card Container -->
                <div class="card-study mb-4">
                    <div class="card-container" @onclick="() => isFlipped = !isFlipped">
                        <div class="card-face front @(isFlipped ? "hidden" : "")">
                            <div class="card-label">Question</div>
                            <div class="card-content">@currentCard.Question</div>
                            <div class="card-hint">Click to reveal answer</div>
                        </div>
                        <div class="card-face back @(!isFlipped ? "hidden" : "")">
                            <div class="card-label">Answer</div>
                            <div class="card-content">@currentCard.Answer</div>
                            <div class="card-hint">Click to hide answer</div>
                        </div>
                    </div>
                </div>

                <!-- Response Buttons -->
                @if (isFlipped)
                {
                    <div class="d-grid gap-2">
                        <div class="row">
                            <div class="col-6">
                                <button class="btn btn-lg btn-outline-danger w-100" @onclick="() => MarkCard(1)">
                                    ❌ Again
                                    <small class="d-block text-muted">1 day</small>
                                </button>
                            </div>
                            <div class="col-6">
                                <button class="btn btn-lg btn-outline-warning w-100" @onclick="() => MarkCard(2)">
                                    ⚠️ Hard
                                    <small class="d-block text-muted">3 days</small>
                                </button>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <button class="btn btn-lg btn-outline-info w-100" @onclick="() => MarkCard(3)">
                                    👍 Good
                                    <small class="d-block text-muted">7 days</small>
                                </button>
                            </div>
                            <div class="col-6">
                                <button class="btn btn-lg btn-outline-success w-100" @onclick="() => MarkCard(4)">
                                    ⭐ Easy
                                    <small class="d-block text-muted">14 days</small>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary text-center">
                        <p>Flip the card to reveal the answer →</p>
                    </div>
                }

                <!-- Exit Button -->
                <div class="mt-4">
                    <a href="/decks" class="btn btn-secondary btn-sm">← Back to Decks</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success text-center">
            <h4>🎉 Study Session Complete!</h4>
            <p>You reviewed @sessionStats.ReviewCount cards. Great work!</p>
            <div class="mb-3">
                <strong>Accuracy: @Math.Round(sessionStats.Accuracy)%</strong>
            </div>
            <a href="/decks" class="btn btn-primary">Back to Decks</a>
        </div>
    }
</div>

<style>
    .card-study {
        perspective: 1000px;
        min-height: 300px;
    }

    .card-container {
        position: relative;
        width: 100%;
        height: 300px;
        cursor: pointer;
        transform-style: preserve-3d;
        transition: transform 0.6s;
    }

    .card-container:hover {
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        border-radius: 8px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        text-align: center;
    }

    .card-face.back {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .card-face.hidden {
        visibility: hidden;
    }

    .card-label {
        font-size: 0.875rem;
        opacity: 0.8;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .card-content {
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 1rem;
        word-wrap: break-word;
    }

    .card-hint {
        font-size: 0.75rem;
        opacity: 0.6;
        margin-top: 1rem;
    }

    .btn-lg {
        font-size: 1rem;
        padding: 1rem;
    }
</style>

@code {
    [Parameter]
    public int DeckId { get; set; }

    private Deck? deck;
    private List<Card> cardsToStudy = new();
    private int currentCardIndex = 0;
    private bool isFlipped = false;
    private SessionStats sessionStats = new();
    private StudySession? studySession;

    protected override async Task OnInitializedAsync()
    {
        await LoadStudyCardsAsync();
    }

    private async Task LoadStudyCardsAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        deck = await context.Decks
            .AsNoTracking()
            .Include(d => d.Cards)
            .FirstOrDefaultAsync(d => d.Id == DeckId);

        if (deck != null)
        {
            cardsToStudy = RepetitionService.GetCardsDueToday(deck.Cards);
        }
    }

    private async Task MarkCard(int difficulty)
    {
        if (currentCardIndex >= cardsToStudy.Count)
            return;

        var currentCard = cardsToStudy[currentCardIndex];
        await using var context = await ContextFactory.CreateDbContextAsync();
        var storedCard = await context.Cards.FindAsync(currentCard.Id);
        if (storedCard is null)
        {
            await LoadStudyCardsAsync();
            return;
        }

        // Update card with spaced repetition logic
        RepetitionService.UpdateCardInterval(storedCard, difficulty);

        // Create the session only when the user answers their first card.
        // This avoids recording empty sessions when a user opens and leaves a deck.
        var isNewSession = studySession is null;
        studySession ??= new StudySession
        {
            DeckId = DeckId,
            StartedAt = DateTime.UtcNow
        };

        sessionStats.ReviewCount++;
        studySession.CardReviewedCount++;
        if (difficulty >= 3)
        {
            sessionStats.CorrectCount++;
            studySession.CardCorrectCount++;
        }

        studySession.DurationSeconds = (int)(DateTime.UtcNow - studySession.StartedAt).TotalSeconds;
        if (currentCardIndex + 1 == cardsToStudy.Count)
        {
            studySession.CompletedAt = DateTime.UtcNow;
        }

        if (isNewSession)
        {
            context.StudySessions.Add(studySession);
        }
        else
        {
            context.StudySessions.Update(studySession);
        }

        context.CardReviews.Add(new CardReview
        {
            CardId = storedCard.Id,
            StudySession = studySession,
            Difficulty = difficulty
        });

        await context.SaveChangesAsync();

        // Move to next card
        isFlipped = false;
        currentCardIndex++;
    }

    private class SessionStats
    {
        public int ReviewCount { get; set; }
        public int CorrectCount { get; set; }

        public double Accuracy => ReviewCount > 0 
            ? Math.Round((double)CorrectCount / ReviewCount * 100, 1) 
            : 0;
    }
}
