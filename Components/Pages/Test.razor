@using Flashminds.Services
@using Flashminds.Data
@using Flashminds.Models
@inject DeckService DeckService

<PageTitle>Test - FlashMind</PageTitle>

<div class="container my-5">
    <h1>🔧 Diagnostic Test</h1>

    <div class="alert alert-info">
        <h5>Testing FlashMind Functionality</h5>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5>Database Status</h5>
        </div>
        <div class="card-body">
            <p><strong>Database File:</strong> <code>flashminds.db</code></p>
            <p><strong>Total Decks:</strong> @decksCount</p>
            <p><strong>Total Cards:</strong> @cardsCount</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5>Test Actions</h5>
        </div>
        <div class="card-body">
            <button class="btn btn-primary me-2" @onclick="TestCreateDeck">
                Test: Create Deck
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(testMessage))
    {
        <div class="alert alert-@(testSuccess ? "success" : "danger")">
            <strong>Test Result:</strong> @testMessage
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5>All Decks</h5>
        </div>
        <div class="card-body">
            @if (allDecks.Count == 0)
            {
                <p class="text-muted">No decks found</p>
            }
            else
            {
                <ul>
                    @foreach (var deck in allDecks)
                    {
                        <li>@deck.Title (@deck.Cards.Count cards)</li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="mt-4">
        <a href="/decks" class="btn btn-secondary">Back to Decks</a>
    </div>
</div>

@code {
    private List<Deck> allDecks = new();
    private int decksCount = 0;
    private int cardsCount = 0;
    private string testMessage = "";
    private bool testSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            allDecks = await DeckService.GetAllDecksAsync();
            decksCount = allDecks.Count;
            cardsCount = allDecks.Sum(d => d.Cards.Count);
            Console.WriteLine($"Loaded {decksCount} decks");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            testMessage = $"Error loading data: {ex.Message}";
            testSuccess = false;
        }
    }

    private async Task TestCreateDeck()
    {
        try
        {
            var deck = await DeckService.CreateDeckAsync("Test Deck " + DateTime.Now.Ticks, "Auto-generated test deck");
            Console.WriteLine($"Created deck: {deck.Id}");
            testMessage = $"✅ Successfully created deck: {deck.Title} (ID: {deck.Id})";
            testSuccess = true;
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            testMessage = $"❌ Error: {ex.Message}";
            testSuccess = false;
        }
    }

}
