@page "/progress"
@using Flashminds.Data
@using Flashminds.Models
@using Flashminds.Services
@using Microsoft.EntityFrameworkCore
@inject FlashmindsContext DbContext
@inject SpacedRepetitionService RepetitionService

<PageTitle>Progress - FlashMind</PageTitle>

<div class="container my-5">
    <h1>📊 Your Progress</h1>

    @if (decks.Count == 0)
    {
        <div class="alert alert-info">
            <p>No decks yet. <a href="/decks" class="alert-link">Create your first deck</a> to start tracking progress!</p>
        </div>
    }
    else
    {
        <!-- Overall Stats -->
        <div class="row mb-4">
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-value">@overallStats.TotalCards</div>
                    <div class="stat-label">Total Cards</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-value">@overallStats.TotalDecks</div>
                    <div class="stat-label">Decks</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-value">@Math.Round(overallStats.AverageMastery)%</div>
                    <div class="stat-label">Avg Mastery</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-value">@overallStats.CardsDueToday</div>
                    <div class="stat-label">Due Today</div>
                </div>
            </div>
        </div>

        <!-- Deck-by-Deck Progress -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Deck Performance</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Deck</th>
                                <th>Total Cards</th>
                                <th>Mastered</th>
                                <th>Mastery %</th>
                                <th>Due Today</th>
                                <th>Avg Accuracy</th>
                                <th>Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (deck, stats) in deckStats)
                            {
                                <tr>
                                    <td>
                                        <strong>@deck.Title</strong>
                                    </td>
                                    <td>@stats.TotalCards</td>
                                    <td>@stats.MasteredCards</td>
                                    <td>
                                        <span class="badge bg-info">@Math.Round(stats.MasteryPercentage)%</span>
                                    </td>
                                    <td>
                                        @if (stats.DueCards > 0)
                                        {
                                            <span class="badge bg-warning">@stats.DueCards</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (stats.TotalReviews > 0)
                                        {
                                            var accuracy = Math.Round(stats.AverageAccuracy, 1);
                                            <span class="@(accuracy >= 80 ? "text-success" : accuracy >= 60 ? "text-warning" : "text-danger")">
                                                @(accuracy)%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 20px; min-width: 100px;">
                                            <div class="progress-bar @GetProgressBarClass(stats.MasteryPercentage)" 
                                                 role="progressbar"
                                                 style="width: @Math.Round(stats.MasteryPercentage)%"
                                                 aria-valuenow="@((int)Math.Round(stats.MasteryPercentage))" 
                                                 aria-valuemin="0" aria-valuemax="100">
                                                @Math.Round(stats.MasteryPercentage)%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Activity Chart (Simple) -->
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Recent Activity</h5>
            </div>
            <div class="card-body">
                @if (recentSessions.Count == 0)
                {
                    <p class="text-muted">No study sessions yet. Start studying to see your activity!</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Deck</th>
                                    <th>Date</th>
                                    <th>Cards Reviewed</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in recentSessions.Take(10))
                                {
                                    <tr>
                                        <td>@session.Deck?.Title</td>
                                        <td>@session.StartedAt.ToString("MMM d, yyyy HH:mm")</td>
                                        <td>@session.CardReviewedCount</td>
                                        <td>@FormatDuration(session.DurationSeconds)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .stat-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .stat-value {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .stat-label {
        font-size: 0.875rem;
        opacity: 0.9;
    }
</style>

@code {
    private List<Deck> decks = new();
    private List<(Deck, DeckStats)> deckStats = new();
    private List<StudySession> recentSessions = new();
    private OverallStats overallStats = new();

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        decks = DbContext.Decks
            .Include(d => d.Cards)
            .Include(d => d.StudySessions)
            .ToList();

        deckStats = decks
            .Select(d => (d, RepetitionService.GetDeckStats(d)))
            .ToList();

        recentSessions = DbContext.StudySessions
            .Include(s => s.Deck)
            .OrderByDescending(s => s.StartedAt)
            .ToList();

        CalculateOverallStats();
    }

    private void CalculateOverallStats()
    {
        overallStats.TotalDecks = decks.Count;
        overallStats.TotalCards = decks.Sum(d => d.Cards.Count);

        if (deckStats.Count > 0)
        {
            overallStats.AverageMastery = deckStats.Average(ds => ds.Item2.MasteryPercentage);
        }

        overallStats.CardsDueToday = decks.Sum(d => RepetitionService.GetCardsDueTodayCount(d.Cards));
    }

    private string GetProgressBarClass(double percentage)
    {
        return percentage >= 80 ? "bg-success" : 
               percentage >= 50 ? "bg-info" : 
               percentage >= 25 ? "bg-warning" : 
               "bg-danger";
    }

    private string FormatDuration(int seconds)
    {
        if (seconds < 60)
            return $"{seconds}s";
        var minutes = seconds / 60;
        return $"{minutes}m";
    }

    private class OverallStats
    {
        public int TotalDecks { get; set; }
        public int TotalCards { get; set; }
        public double AverageMastery { get; set; }
        public int CardsDueToday { get; set; }
    }
}
