@page "/deck/{DeckId:int}/edit"
@attribute [Authorize]
@using Flashminds.Data
@using Flashminds.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<FlashmindsContext> ContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Edit Deck - FlashMind</PageTitle>

<div class="app-page">
    @if (deck == null)
    {
        <div class="alert alert-info">Loading deck...</div>
    }
    else
    {
        <div class="page-heading">
            <div>
                <div class="eyebrow">Deck editor</div>
                <h1>@deck.Title</h1>
                <p>Refine your deck, then add the cards that will make it useful.</p>
            </div>
            <a href="/decks" class="btn btn-secondary">Back to decks</a>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="fs-5 mb-4">Deck information</h2>
                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" @bind="deck.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" @bind="deck.Description" rows="3"></textarea>
                        </div>
                        <button class="btn btn-success me-2" @onclick="SaveDeckAsync">Save</button>
                        <a href="/decks" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h2 class="fs-5 mb-0">Cards (@deck.Cards.Count)</h2>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-secondary" @onclick="ToggleImportForm">Import cards</button>
                                <button class="btn btn-sm btn-primary" @onclick="() => showAddForm = true">+ Add Card</button>
                            </div>
                        </div>

                        @if (showAddForm)
                        {
                            <div class="alert alert-info mb-3">
                                <div class="mb-2">
                                    <label>Question</label>
                                    <textarea class="form-control" @bind="newQuestion" rows="2"></textarea>
                                </div>
                                <div class="mb-2">
                                    <label>Answer</label>
                                    <textarea class="form-control" @bind="newAnswer" rows="2"></textarea>
                                </div>
                                <button class="btn btn-sm btn-success me-2" @onclick="AddCardAsync">Add</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => showAddForm = false">Cancel</button>
                            </div>
                        }

                        @if (showImportForm)
                        {
                            <div class="alert alert-info mb-3">
                                <h3 class="fs-6">Import cards from text or CSV</h3>
                                <p class="small text-muted">Paste one card per line using a pipe, tab, or comma between the question and answer. Example: <code>What is active recall? | Retrieving information from memory</code></p>
                                <textarea class="form-control mb-2" @bind="importText" rows="7" placeholder="Question | Answer&#10;Another question | Another answer"></textarea>
                                <button class="btn btn-sm btn-success me-2" @onclick="ImportCardsAsync">Import cards</button>
                                <button class="btn btn-sm btn-secondary" @onclick="ToggleImportForm">Cancel</button>
                                @if (!string.IsNullOrWhiteSpace(importMessage))
                                {
                                    <p class="text-success small mt-2 mb-0">@importMessage</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(importError))
                                {
                                    <p class="text-danger small mt-2 mb-0">@importError</p>
                                }
                            </div>
                        }

                        @if (deck.Cards.Count == 0)
                        {
                            <p class="text-muted">No cards yet</p>
                        }
                        else
                        {
                            <table class="table table-sm">
                                <tr>
                                    <th>Q</th>
                                    <th>A</th>
                                    <th></th>
                                </tr>
                                @foreach (var card in deck.Cards)
                                {
                                    <tr>
                                        <td>@card.Question.Substring(0, Math.Min(30, card.Question.Length))</td>
                                        <td>@card.Answer.Substring(0, Math.Min(30, card.Answer.Length))</td>
                                        <td>
                                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteCardAsync(card.Id)">X</button>
                                        </td>
                                    </tr>
                                }
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int DeckId { get; set; }

    private Deck? deck;
    private bool showAddForm = false;
    private bool showImportForm = false;
    private string newQuestion = "";
    private string newAnswer = "";
    private string importText = "";
    private string importMessage = "";
    private string importError = "";
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadDeckAsync();
    }

    private async Task LoadDeckAsync()
    {
        try
        {
            Console.WriteLine($"Loading deck {DeckId}...");
            await using var context = await ContextFactory.CreateDbContextAsync();
            deck = await context.Decks
                .Include(d => d.Cards)
                .FirstOrDefaultAsync(d => d.Id == DeckId && d.OwnerId == userId);
            Console.WriteLine($"✅ Loaded deck: {deck?.Title}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading deck: {ex}");
        }
    }

    private async Task SaveDeckAsync()
    {
        if (deck == null) return;

        try
        {
            Console.WriteLine($"Saving deck {deck.Id}...");
            await using var context = await ContextFactory.CreateDbContextAsync();
            deck.UpdatedAt = DateTime.UtcNow;
            var storedDeck = await context.Decks.FirstOrDefaultAsync(d => d.Id == deck.Id && d.OwnerId == userId);
            if (storedDeck is null)
                return;

            storedDeck.Title = deck.Title;
            storedDeck.Description = deck.Description;
            storedDeck.UpdatedAt = DateTime.UtcNow;
            await context.SaveChangesAsync();
            Console.WriteLine($"✅ Deck saved");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error saving deck: {ex}");
        }
    }

    private async Task AddCardAsync()
    {
        if (string.IsNullOrWhiteSpace(newQuestion) || string.IsNullOrWhiteSpace(newAnswer) || deck == null)
            return;

        try
        {
            Console.WriteLine($"Adding card to deck {deck.Id}...");
            await using var context = await ContextFactory.CreateDbContextAsync();

            var card = new Card
            {
                DeckId = deck.Id,
                Question = newQuestion,
                Answer = newAnswer,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            context.Cards.Add(card);
            await context.SaveChangesAsync();
            Console.WriteLine($"✅ Card added");

            newQuestion = "";
            newAnswer = "";
            showAddForm = false;
            await LoadDeckAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error adding card: {ex}");
        }
    }

    private void ToggleImportForm()
    {
        showImportForm = !showImportForm;
        importMessage = "";
        importError = "";
        if (!showImportForm)
            importText = "";
    }

    private async Task ImportCardsAsync()
    {
        if (deck is null)
            return;

        var candidates = ParseImportedCards(importText).ToList();
        if (candidates.Count == 0)
        {
            importError = "Add at least one complete question and answer pair. Use |, a tab, or a comma between them.";
            importMessage = "";
            return;
        }

        if (candidates.Count > 500)
        {
            importError = "Import up to 500 cards at a time.";
            importMessage = "";
            return;
        }

        await using var context = await ContextFactory.CreateDbContextAsync();
        var ownedDeck = await context.Decks
            .Include(item => item.Cards)
            .FirstOrDefaultAsync(item => item.Id == deck.Id && item.OwnerId == userId);
        if (ownedDeck is null)
            return;

        var knownQuestions = ownedDeck.Cards
            .Select(card => card.Question.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var cardsToAdd = candidates
            .Where(candidate => knownQuestions.Add(candidate.Question))
            .Select(candidate => new Card
            {
                DeckId = ownedDeck.Id,
                Question = candidate.Question,
                Answer = candidate.Answer,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            })
            .ToList();

        if (cardsToAdd.Count == 0)
        {
            importError = "Every imported question is already in this deck.";
            importMessage = "";
            return;
        }

        context.Cards.AddRange(cardsToAdd);
        await context.SaveChangesAsync();
        var skipped = candidates.Count - cardsToAdd.Count;
        importMessage = $"Imported {cardsToAdd.Count} card{(cardsToAdd.Count == 1 ? "" : "s")}{(skipped > 0 ? $"; skipped {skipped} duplicate{(skipped == 1 ? "" : "s")}" : "")}.";
        importError = "";
        importText = "";
        await LoadDeckAsync();
    }

    private static IEnumerable<(string Question, string Answer)> ParseImportedCards(string source)
    {
        foreach (var rawLine in source.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var line = rawLine.Trim('\r', ' ', '\t');
            var separator = line.Contains('|') ? '|' : line.Contains('\t') ? '\t' : ',';
            var separatorIndex = line.IndexOf(separator);
            if (separatorIndex <= 0 || separatorIndex >= line.Length - 1)
                continue;

            var question = line[..separatorIndex].Trim().Trim('"');
            var answer = line[(separatorIndex + 1)..].Trim().Trim('"');
            if (!string.IsNullOrWhiteSpace(question) && !string.IsNullOrWhiteSpace(answer))
                yield return (question, answer);
        }
    }

    private async Task DeleteCardAsync(int cardId)
    {
        try
        {
            Console.WriteLine($"Deleting card {cardId}...");
            await using var context = await ContextFactory.CreateDbContextAsync();
            var card = await context.Cards
                .Include(c => c.Deck)
                .FirstOrDefaultAsync(c => c.Id == cardId && c.Deck!.OwnerId == userId);
            if (card != null)
            {
                context.Cards.Remove(card);
                await context.SaveChangesAsync();
                Console.WriteLine($"✅ Card deleted");
                await LoadDeckAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error deleting card: {ex}");
        }
    }
}
