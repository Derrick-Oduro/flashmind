@page "/progress"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Progress - FlashMind</PageTitle>

<div class="app-page">
    <div class="page-heading">
        <div>
            <div class="eyebrow">Your learning snapshot</div>
            <h1>Progress</h1>
            <p>See what is sticking and what deserves another pass.</p>
        </div>
    </div>

    @if (decks.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">↗</div>
            <h2>Progress starts with one deck</h2>
            <p><a href="/decks">Create your first deck</a> to start tracking your learning.</p>
        </div>
    }
    else
    {
        <!-- Overall Stats -->
        <div class="row mb-4">
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-value">@overallStats.TotalCards</div>
                    <div class="stat-label">Total Cards</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-value">@overallStats.TotalDecks</div>
                    <div class="stat-label">Decks</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-value">@Math.Round(overallStats.AverageMastery)%</div>
                    <div class="stat-label">Avg Mastery</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-value">@overallStats.CardsDueToday</div>
                    <div class="stat-label">Due Today</div>
                </div>
            </div>
        </div>

        <!-- Deck-by-Deck Progress -->
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="mb-0 fs-5">Deck performance</h2>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Deck</th>
                                <th>Total Cards</th>
                                <th>Mastered</th>
                                <th>Mastery %</th>
                                <th>Due Today</th>
                                <th>Avg Accuracy</th>
                                <th>Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deck in decks)
                            {
                                var stats = deck;
                                <tr>
                                    <td>
                                        <strong>@deck.Title</strong>
                                    </td>
                                    <td>@stats.TotalCards</td>
                                    <td>@stats.MasteredCards</td>
                                    <td>
                                        <span class="badge bg-info">@Math.Round(stats.MasteryPercentage)%</span>
                                    </td>
                                    <td>
                                        @if (stats.DueCards > 0)
                                        {
                                            <span class="badge bg-warning">@stats.DueCards</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (stats.TotalReviews > 0)
                                        {
                                            var accuracy = Math.Round(stats.AverageAccuracy, 1);
                                            <span class="@(accuracy >= 80 ? "text-success" : accuracy >= 60 ? "text-warning" : "text-danger")">
                                                @(accuracy)%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 20px; min-width: 100px;">
                                            <div class="progress-bar @GetProgressBarClass(stats.MasteryPercentage)" 
                                                 role="progressbar"
                                                 style="width: @Math.Round(stats.MasteryPercentage)%"
                                                 aria-valuenow="@((int)Math.Round(stats.MasteryPercentage))" 
                                                 aria-valuemin="0" aria-valuemax="100">
                                                @Math.Round(stats.MasteryPercentage)%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Activity Chart (Simple) -->
        <div class="card">
            <div class="card-header">
                <h2 class="mb-0 fs-5">Recent activity</h2>
            </div>
            <div class="card-body">
                @if (recentSessions.Count == 0)
                {
                    <p class="text-muted">No study sessions yet. Start studying to see your activity!</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Deck</th>
                                    <th>Date</th>
                                    <th>Cards Reviewed</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in recentSessions.Take(10))
                                {
                                    <tr>
                                        <td>@session.DeckTitle</td>
                                        <td>@session.StartedAt.ToString("MMM d, yyyy HH:mm")</td>
                                        <td>@session.CardReviewedCount</td>
                                        <td>@FormatDuration(session.DurationSeconds)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<DeckSummaryDto> decks = new();
    private List<StudySessionDto> recentSessions = new();
    private ProgressDto overallStats = new(0, 0, 0, 0, [], []);

    protected override async Task OnInitializedAsync()
    {
        overallStats = await Api.GetProgressAsync();
        decks = overallStats.Decks;
        recentSessions = overallStats.RecentSessions;
    }

    private string GetProgressBarClass(double percentage)
    {
        return percentage >= 80 ? "bg-success" : 
               percentage >= 50 ? "bg-info" : 
               percentage >= 25 ? "bg-warning" : 
               "bg-danger";
    }

    private string FormatDuration(int seconds)
    {
        if (seconds < 60)
            return $"{seconds}s";
        var minutes = seconds / 60;
        return $"{minutes}m";
    }
}
